@model BeFit.Models.ExerciseEntry
@{ ViewData["Title"] = "Szczegóły"; }
<h1>Szczegóły</h1>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.ExerciseType)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.ExerciseType.Name)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.WorkoutSession)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.WorkoutSession.StartTime)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Weight)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Weight)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Sets)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Sets)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Reps)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Reps)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edytuj</a> |
    <a asp-action="Index">Wróć do listy</a>
</div>